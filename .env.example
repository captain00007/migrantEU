# =============================================================================
# Configurações Gerais do migrantEU (FastAPI Monolith)
# =============================================================================
APP_NAME=migrantEU
APP_ENV=development
DEBUG=True
SECRET_KEY=migranteu-insecure-change-me-in-production-secret-token
ALLOWED_HOSTS=*
BASE_URL=http://localhost:8000

# =============================================================================
# Conexão Banco de Dados (100% Supabase)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# 🧠 SELEÇÃO ATIVA DE INTELIGÊNCIA ARTIFICIAL (Switches Principais)
# =============================================================================
AI_LLM_PROVIDER=google
AI_LLM_MODEL=gemini-1.5-flash

AI_EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=models/text-embedding-004

# Dimensão Vetorial Padronizada: 768 (Unifica Gemini 768, Ollama 768 e OpenAI MRL 768)
AI_EMBEDDING_DIMENSIONS=768

# =============================================================================
# 1. Provedor: Google Gemini (Padrão Ativo)
# =============================================================================
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# =============================================================================
# 2. Provedor: OpenAI
# =============================================================================
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# 3. Provedor: Ollama (100% Local / LLaMA / Nomic / BGE)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Ferramentas Adicionais (Busca Web)
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# Envio de E-mails Transacionais (Resend)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificacoes@migranteu.org

# =============================================================================
# 📊 Observabilidade & Métricas de Custo e Tokens (LangSmith)
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=migranteu
