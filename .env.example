# =============================================================================
# Configurações Gerais do migrantEU (FastAPI Monolith)
# =============================================================================
APP_NAME=migrantEU
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=migranteu-insecure-change-me-in-production-secret-token
ALLOWED_HOSTS=*
BASE_URL=http://localhost:8000

# =============================================================================
# Conexão Banco de Dados (100% Supabase)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# Segurança de Sessão de Administração (Cookies)
# =============================================================================
ADMIN_SESSION_COOKIE_NAME=migranteu_admin_token
ADMIN_SESSION_MAX_AGE_SECONDS=86400

# =============================================================================
# Limites de Listagem e Paginação de Editais
# =============================================================================
HOME_NOTICES_LIMIT=6
CATALOG_NOTICES_LIMIT=50

# =============================================================================
# Agendador Diário (APScheduler)
# =============================================================================
SCHEDULER_CRON_HOUR=0
SCHEDULER_CRON_MINUTE=5

# =============================================================================
# Robô de Coleta e Requisições HTTP
# =============================================================================
BOT_USER_AGENT=migrantEU-Bot/1.0 (+https://migranteu.org; Informações para Refugiados)
HTTP_TIMEOUT_SECONDS=12.0

# =============================================================================
# 🧠 SELEÇÃO ATIVA DE INTELIGÊNCIA ARTIFICIAL (Switches Principais)
# =============================================================================
# Opções de provedor: google (ou gemini) | openai | ollama (ou llama)
AI_LLM_PROVIDER=google
AI_LLM_MODEL=gemini-1.5-flash

AI_EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=models/text-embedding-004

# Dimensão Vetorial Padronizada: 768 (Unifica Gemini 768, Ollama 768 e OpenAI MRL 768)
AI_EMBEDDING_DIMENSIONS=768

AI_TEMPERATURE=0.2
AI_AGENT_MAX_ITERATIONS=4

# Parâmetros de Busca Vetorial Semântica (pgvector)
AI_VECTOR_THRESHOLD=0.60
AI_VECTOR_LIMIT=4

# Limite de Caracteres no Leitor de Editais em Tempo Real (Live Reader)
AI_READER_MAX_CHARS=4000

# =============================================================================
# 1. Provedor: Google Gemini (Padrão Ativo)
# =============================================================================
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# =============================================================================
# 2. Provedor: OpenAI
# =============================================================================
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# 3. Provedor: Ollama (100% Local / LLaMA / Nomic / BGE)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Ferramentas Adicionais (Busca Web)
# =============================================================================
TAVILY_API_KEY=
AI_SEARCH_MAX_RESULTS=3
AI_SEARCH_DEPTH=advanced

# Domínios adicionais autorizados no DomainGuard (separados por vírgula)
DOMAIN_GUARD_CUSTOM_DOMAINS=

# =============================================================================
# Envio de E-mails Transacionais (Resend)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificacoes@migranteu.org

# =============================================================================
# 📊 Observabilidade & Métricas de Custo e Tokens (LangSmith)
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=migranteu
